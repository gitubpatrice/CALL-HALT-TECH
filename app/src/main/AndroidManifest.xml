<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No network permission, ever (PROJET.md, § 1). Removed explicitly, in case a library adds one at
        merge time: the CI reads the MERGED release manifest against a reviewed list, with a negative
        control (tools/check-manifest-permissions.py).

        Every other permission arrives WITH the component that uses it, in the same commit as its line in
        tools/check-manifest-permissions.py and in PRIVACY.md (docs/ARCHITECTURE.md, D-007). So does every service
        the system binds with a special access (notification access below).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- When a call starts and ends: platform/telephony/CallStateReceiver. Not the number (READ_CALL_LOG). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        "Display over other apps": what lets platform/stop/StopActivity start from the background, over the banking
        app (docs/ARCHITECTURE.md, D-006). The screen is an activity, never an overlay window.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- "Hang up" on the STOP screen: platform/stop/CallControl. Offered only when granted (ui/stop/StopText). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
        What lets the activation show the phone's own dialog, "Let app always run in background?"
        (platform/access/AccessSettings.background): never put to sleep, the protection keeps working when the app is
        not opened (docs/ARCHITECTURE.md, D-023; Samsung's deep sleep makes it deaf, measured). It reads nothing.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        The STOP screen's fallback, when the phone blocks it (platform/stop/StopNotifier, docs/ARCHITECTURE.md, D-024):
        a notification that opens it. Android 13+ asks the user (the activation's last step); the app posts no other.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- That notification opens the STOP screen at once on a locked or sleeping phone: a full-screen notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        A text to the relative the user chose (platform/guardian, docs/ARCHITECTURE.md, D-034): when a STOP shows, when
        "Continue" is chosen despite it, when they are chosen or no longer are. Asked on the relative's screen, not by the
        activation: no relative, no text. Sends only: never READ_SMS nor RECEIVE_SMS (a code is seen in the SMS app's
        notification, D-021).
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!--
        SEND_SMS would otherwise make the phone's telephony REQUIRED, and keep the app from a device without it. Not
        needed: there, the relative is not texted (platform/guardian/TextSender), and nothing else changes.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
        The phone's settings pages the app opens: seen here so that platform/access/AccessSettings can send the
        user to the SYSTEM's own, never to an app that declares the same action. Not a permission: these names only.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
            <data android:scheme="package" />
        </intent>
        <!-- Lint's BatteryLife: a Play Store rule; the app is published on F-Droid (D-016), see the permission above. -->
        <intent>
            <action
                android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
                tools:ignore="BatteryLife" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENT" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <!-- Not an access: where the home screen sends the user to free some space (docs/ARCHITECTURE.md, P-10). -->
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <!-- Nor this one: where the STOP screen sends the user to turn off an app's accessibility access (D-033). -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <!-- Xiaomi's Security app, where its autostart is allowed (platform/access/Miui, D-025): a page, by its name. -->
        <package android:name="com.miui.securitycenter" />
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <!--
        The SMS apps, so that platform/notification/NotificationListener knows which one is the default
        (Telephony.Sms.getDefaultSmsPackage sees only the apps this one may see, from Android 11). Without it, the answer
        is "none" (measured on the S24 FE and Android 16, 2026-11-03), and a code SMS was read only because Android lets a
        listener see the app of each notification it delivers. Not the SMS_DELIVER its documentation names: a protected
        broadcast, and AOSP's AppsFilterUtils ignores protected broadcasts when it matches a query against receivers
        (still "none", DefaultSmsAppOnDeviceTest red). Writing an SMS is what every SMS app must handle to be the default
        one. Names only, like the block above.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!--
        The apps that let someone else control this phone (platform/install/RemoteControlApps, docs/ARCHITECTURE.md,
        D-031): Android tells the app of their installation, and of no other one. Not QUERY_ALL_PACKAGES: the app sees
        these apps only. The same list as REMOTE_CONTROL_APPS, kept equal by RemoteControlAppsTest.
    -->
    <queries>
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.anydesk.adcontrol.ad1" />
        <package android:name="com.anydesk.adcontrol.htc1" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.teamviewer.quicksupport.addon.universal" />
        <package android:name="com.teamviewer.quicksupport.addon.mobilebase" />
        <package android:name="com.teamviewer.quicksupport.addon.aosp7" />
        <package android:name="com.teamviewer.quicksupport.addon.doro" />
        <package android:name="com.teamviewer.quicksupport.addon.nokia_4_2" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.hoptodesk.app" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airsos" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.sand.aircast" />
        <package android:name="com.sand.remotesupportaddon" />
        <package android:name="com.splashtop.sos" />
        <package android:name="com.splashtop.sos.onprem" />
        <package android:name="com.splashtop.streamer.csrs" />
        <package android:name="com.splashtop.streamer.csrs.enterprise" />
        <package android:name="com.splashtop.streamer.addon.knox" />
        <package android:name="com.zoho.assist.agent" />
        <package android:name="com.zoho.remoteplugin.universal" />
        <package android:name="com.logmein.rescuemobile" />
        <package android:name="com.goto.resolve.customer" />
        <package android:name="com.logmein.rescueassist" />
        <package android:name="com.logmein.g2acorpcustomer" />
        <package android:name="com.islonline.isllight.mobile.android" />
        <package android:name="com.islonline.isllight.mobile.android.universaladdon" />
        <package android:name="com.islonline.isllight.mobile.android.addon.LG" />
        <package android:name="com.bomgar.thinclient.android" />
        <package android:name="com.bomgar.thinpin.android" />
        <package android:name="com.aomei.anyviewer" />
        <package android:name="it.nanosystems.supremo.host" />
        <package android:name="it.nanosystems.supremo.addon" />
        <package android:name="me.getscreen.agent" />
        <package android:name="com.awesun.client.service" />
        <package android:name="com.remotepc.host" />
        <package android:name="com.screenconnect.androidclient" />
        <package android:name="com.zuler.deskin" />
        <package android:name="com.raywing.avica" />
        <package android:name="com.entersoftware.iperiusremotedesktop" />
        <package android:name="net.tsplus.remotesupport" />
        <package android:name="com.projector.screenmeet.support" />
        <package android:name="com.simplehelp.remotesupport" />
        <package android:name="com.rsupport.rs.activity.rsupport" />
        <package android:name="com.realvnc.server" />
        <package android:name="net.christianbeier.droidvnc_ng" />
    </queries>

    <!--
        The phone's own accessibility features (platform/accessibility/AccessibilityGrants, docs/ARCHITECTURE.md, D-033):
        seen, to tell whether one turned on is preinstalled — then it is no app being given the access. The same list as
        SYSTEM_ACCESSIBILITY_SUITES, kept equal by RemoteControlAppsTest.
    -->
    <queries>
        <package android:name="com.google.android.marvin.talkback" />
        <package android:name="com.google.android.apps.accessibility.voiceaccess" />
        <package android:name="com.google.android.accessibility.switchaccess" />
        <package android:name="com.android.systemui.accessibility.accessibilitymenu" />
        <package android:name="com.samsung.accessibility" />
        <package android:name="com.samsung.android.accessibility.talkback" />
        <package android:name="com.samsung.android.bixby.agent" />
        <package android:name="com.sec.android.app.camera" />
    </queries>

    <!--
        No backup, no device transfer: the journal says who called, when, and what the user chose. It stays
        on this phone (data_extraction_rules.xml for Android 12+, allowBackup for the older ones).
    -->
    <application
        android:name=".CallHaltApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallHaltTech"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The STOP screen, started by the app alone (not exported). A task of its own, so that it never brings
            the app's other screens along, and out of the recent apps: once answered, it is gone. Red from the first
            frame (Theme.CallHaltTech.Stop).
        -->
        <activity
            android:name=".platform.stop.StopActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.stop"
            android:theme="@style/Theme.CallHaltTech.Stop" />

        <!--
            The phone's call state, delivered even when the app is not running (PHONE_STATE is exempt from the
            ban on implicit broadcasts). Exported, safely: PHONE_STATE is a PROTECTED broadcast that only the
            system may send (measured on the S9: even the adb shell is refused), so no app can forge a call;
            exported, it is also heard from a phone that sends it from its telephony process. The receiver
            ignores any other action.
        -->
        <receiver
            android:name=".platform.telephony.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
            The phone's answer for each text sent to the relative (platform/guardian/TextSender): reached only through the
            app's own PendingIntent, which the phone sends as this app. Not exported, no intent filter.
        -->
        <receiver
            android:name=".platform.guardian.SmsSentReceiver"
            android:exported="false" />

        <!--
            A banking app's request to approve an operation, and a validation code arriving by SMS, seen in their
            notifications. Not a permission: an access the user grants in the phone's settings ("notification access", a
            restricted setting for an app installed from a file). Bound by the system alone
            (BIND_NOTIFICATION_LISTENER_SERVICE); it reads the app and the channel of each notification, and the latest
            message of the default SMS app's, in memory (D-021). Checked by tools/check-manifest-permissions.py, with
            PRIVACY.md (D-007).
        -->
        <service
            android:name=".platform.notification.NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
