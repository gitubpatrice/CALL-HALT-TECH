<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No network permission, ever (PROJET.md, § 1). Removed explicitly, in case a library adds one at
        merge time: the CI reads the MERGED release manifest against a reviewed list, with a negative
        control (tools/check-manifest-permissions.py).

        Every other permission arrives WITH the component that uses it, in the same commit as its line in
        tools/check-manifest-permissions.py and in PRIVACY.md (docs/ARCHITECTURE.md, D-007). So does every service
        the system binds with a special access (notification access below).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- When a call starts and ends: platform/telephony/CallStateReceiver. Not the number (READ_CALL_LOG). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        "Display over other apps": what lets platform/stop/StopActivity start from the background, over the banking
        app (docs/ARCHITECTURE.md, D-006). The screen is an activity, never an overlay window.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- "Hang up" on the STOP screen: platform/stop/CallControl. Offered only when granted (ui/stop/StopText). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
        No backup, no device transfer: the journal says who called, when, and what the user chose. It stays
        on this phone (data_extraction_rules.xml for Android 12+, allowBackup for the older ones).
    -->
    <application
        android:name=".CallHaltApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallHaltTech"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The STOP screen, started by the app alone (not exported). A task of its own, so that it never brings
            the app's other screens along, and out of the recent apps: once answered, it is gone. Red from the first
            frame (Theme.CallHaltTech.Stop).
        -->
        <activity
            android:name=".platform.stop.StopActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.stop"
            android:theme="@style/Theme.CallHaltTech.Stop" />

        <!--
            The phone's call state, delivered even when the app is not running (PHONE_STATE is exempt from the
            ban on implicit broadcasts). Exported, safely: PHONE_STATE is a PROTECTED broadcast that only the
            system may send (measured on the S9: even the adb shell is refused), so no app can forge a call;
            exported, it is also heard from a phone that sends it from its telephony process. The receiver
            ignores any other action.
        -->
        <receiver
            android:name=".platform.telephony.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
            A banking app's request to approve an operation, seen in its notification. Not a permission: an access the
            user grants in the phone's settings ("notification access", a restricted setting for an app installed from
            a file). Bound by the system alone (BIND_NOTIFICATION_LISTENER_SERVICE); it reads the app and the channel of
            each notification, nothing else. Checked by tools/check-manifest-permissions.py, with PRIVACY.md (D-007).
        -->
        <service
            android:name=".platform.notification.NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
