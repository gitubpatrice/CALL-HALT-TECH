<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        No network permission, ever (PROJET.md, § 1). Removed explicitly, in case a library adds one at
        merge time: the CI reads the MERGED release manifest against a reviewed list, with a negative
        control (tools/check-manifest-permissions.py).

        Every other permission arrives WITH the component that uses it, in the same commit as its line in
        tools/check-manifest-permissions.py and in PRIVACY.md (docs/ARCHITECTURE.md, D-007). So does every service
        the system binds with a special access (notification access below).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- When a call starts and ends: platform/telephony/CallStateReceiver. Not the number (READ_CALL_LOG). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        "Display over other apps": what lets platform/stop/StopActivity start from the background, over the banking
        app (docs/ARCHITECTURE.md, D-006). The screen is an activity, never an overlay window.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- "Hang up" on the STOP screen: platform/stop/CallControl. Offered only when granted (ui/stop/StopText). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!--
        What lets the activation show the phone's own dialog, "Let app always run in background?"
        (platform/access/AccessSettings.background): never put to sleep, the protection keeps working when the app is
        not opened (docs/ARCHITECTURE.md, D-023; Samsung's deep sleep makes it deaf, measured). It reads nothing.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        The STOP screen's fallback, when the phone blocks it (platform/stop/StopNotifier, docs/ARCHITECTURE.md, D-024):
        a notification that opens it. Android 13+ asks the user (the activation's last step); the app posts no other.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- That notification opens the STOP screen at once on a locked or sleeping phone: a full-screen notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        The phone's settings pages the app opens: seen here so that platform/access/AccessSettings can send the
        user to the SYSTEM's own, never to an app that declares the same action. Not a permission: these names only.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
            <data android:scheme="package" />
        </intent>
        <!-- Lint's BatteryLife: a Play Store rule; the app is published on F-Droid (D-016), see the permission above. -->
        <intent>
            <action
                android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
                tools:ignore="BatteryLife" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <!-- Not an access: where the home screen sends the user to free some space (docs/ARCHITECTURE.md, P-10). -->
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <!--
        The SMS apps, so that platform/notification/NotificationListener knows which one is the default
        (Telephony.Sms.getDefaultSmsPackage sees only the apps this one may see, from Android 11). Without it, the answer
        is "none" (measured on the S24 FE and Android 16, 2026-11-03), and a code SMS was read only because Android lets a
        listener see the app of each notification it delivers. Not the SMS_DELIVER its documentation names: a protected
        broadcast, and AOSP's AppsFilterUtils ignores protected broadcasts when it matches a query against receivers
        (still "none", DefaultSmsAppOnDeviceTest red). Writing an SMS is what every SMS app must handle to be the default
        one. Names only, like the block above.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!--
        No backup, no device transfer: the journal says who called, when, and what the user chose. It stays
        on this phone (data_extraction_rules.xml for Android 12+, allowBackup for the older ones).
    -->
    <application
        android:name=".CallHaltApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallHaltTech"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The STOP screen, started by the app alone (not exported). A task of its own, so that it never brings
            the app's other screens along, and out of the recent apps: once answered, it is gone. Red from the first
            frame (Theme.CallHaltTech.Stop).
        -->
        <activity
            android:name=".platform.stop.StopActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.stop"
            android:theme="@style/Theme.CallHaltTech.Stop" />

        <!--
            The phone's call state, delivered even when the app is not running (PHONE_STATE is exempt from the
            ban on implicit broadcasts). Exported, safely: PHONE_STATE is a PROTECTED broadcast that only the
            system may send (measured on the S9: even the adb shell is refused), so no app can forge a call;
            exported, it is also heard from a phone that sends it from its telephony process. The receiver
            ignores any other action.
        -->
        <receiver
            android:name=".platform.telephony.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
            A banking app's request to approve an operation, and a validation code arriving by SMS, seen in their
            notifications. Not a permission: an access the user grants in the phone's settings ("notification access", a
            restricted setting for an app installed from a file). Bound by the system alone
            (BIND_NOTIFICATION_LISTENER_SERVICE); it reads the app and the channel of each notification, and the latest
            message of the default SMS app's, in memory (D-021). Checked by tools/check-manifest-permissions.py, with
            PRIVACY.md (D-007).
        -->
        <service
            android:name=".platform.notification.NotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
