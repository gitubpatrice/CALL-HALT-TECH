<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no app data in the cloud backup or in a device-to-device transfer. The journal names the
     numbers that called and what the user chose: it stays on this phone. Every domain is excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
